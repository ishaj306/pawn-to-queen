# Pawn to Queen — npm config committed for reproducible installs.
#
# legacy-peer-deps is required because @clerk/nextjs@6.x declares its
# Next.js peer dep range conservatively, and npm's strict peer-resolution
# (introduced in v7) rejects the resolved tree even though it actually
# works at runtime. Without this, `npm ci` fails on Vercel and any other
# build that doesn't share our local install flags.
legacy-peer-deps=true
