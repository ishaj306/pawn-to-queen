# Pawn to Queen — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# ─── Supabase (Postgres only after Phase 2) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                # anon public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                    # server-only; bypasses RLS

# Optional but recommended in production. Use Supabase's pooled connection
# string (PgBouncer transaction mode) so cold-start serverless functions
# don't exhaust the direct connection cap (60 on free, 200 on paid).
# Find it in Supabase Dashboard → Settings → Database → Connection string →
# "Transaction" mode. Looks like: postgres://...pooler.supabase.com:6543/postgres
SUPABASE_POOLER_URL=

# ─── Clerk ──────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Tell Clerk where our custom auth pages live.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
