# Pawn to Queen — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# ─── Supabase (Postgres only after Phase 2) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                # anon public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                    # server-only; bypasses RLS

# NOTE: We removed SUPABASE_POOLER_URL support from the runtime code
# after realising the Supabase JS SDK talks to PostgREST over HTTPS and
# does NOT use the pooled Postgres connection string. If you're on a
# future setup that uses the `pg` driver directly, you can wire it there,
# but don't set it for the JS SDK — createClient() will treat it as an
# HTTPS URL and every fetch will fail with "fetch failed".

# ─── Clerk ──────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Tell Clerk where our custom auth pages live.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
